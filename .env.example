# Copiá este archivo a ".env.local" (para desarrollo) y cargá los mismos
# nombres como variables de entorno en Vercel (para producción).
# Nunca subas tu archivo .env.local real a git.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Mercado Pago → Tus integraciones → Credenciales de producción (o de prueba)
# El Access Token es SECRETO: solo se usa en las funciones serverless (api/),
# nunca lo pongas en variables VITE_* porque esas quedan visibles en el navegador.
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-privado

# Clave pública de Mercado Pago (esta sí puede ir en el frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=tu-public-key

# URL pública donde queda publicada la app (para armar los links de vuelta
# de Mercado Pago). En local podés dejar http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# Service role key de Supabase (SECRETA, solo para la función del webhook,
# nunca en variables VITE_*). Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
